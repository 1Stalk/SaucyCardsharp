<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <AssemblyName>SaucyCardsharp</AssemblyName>
        <PackageId>SaucyCardsharp</PackageId>
        <Authors>Taurenkey, Kagekazu, Knightmore, 1Stalk</Authors>
        <Version>2.1.2.7</Version>
    </PropertyGroup>

    <PropertyGroup>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <!-- Apply .editorconfig code-style (IDE*) and analyzers on Debug builds and when CI=true. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(CI)' == 'true'">
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    </PropertyGroup>

    <PropertyGroup Condition="'$(OS)' != 'Windows_NT' OR '$(CI)' == 'true'">
        <DalamudLibPath>$(DALAMUD_HOME)/</DalamudLibPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ECommons" Version="3.2.1.22" />
        <PackageReference Include="NAudio" Version="2.3.0"/>
        <ProjectReference Include="..\PunishLib\PunishLib\PunishLib.csproj"/>
        <ProjectReference Include="..\XIVcardsharp\XIVcardsharp.Core\XIVcardsharp.Core.csproj"/>
        <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.2"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="SaucyCardsharp.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="..\images\icon.png" Link="images\icon.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Include="Sounds\Game Over.mp3">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="Sounds\Moogle.mp3">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="Sounds\Time Up.mp3">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="SyncBuildOutputs" AfterTargets="Build">
        <ItemGroup>
            <SyncFiles Include="$(TargetDir)*.dll;$(TargetDir)*.pdb;$(TargetDir)*.json" />
            <SyncImageFiles Include="$(TargetDir)images\*.*" />
            <SyncSoundFiles Include="$(TargetDir)Sounds\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(SyncFiles)" DestinationFolder="$(ProjectDir)bin\Debug\" Condition="'$(Platform)' == 'x64' And '$(Configuration)' == 'Debug'" ContinueOnError="true" />
        <Copy SourceFiles="@(SyncFiles)" DestinationFolder="$(ProjectDir)bin\x64\Debug\" Condition="'$(Platform)' != 'x64' And '$(Configuration)' == 'Debug'" ContinueOnError="true" />
        <Copy SourceFiles="@(SyncImageFiles)" DestinationFolder="$(ProjectDir)bin\Debug\images\" Condition="'$(Platform)' == 'x64' And '$(Configuration)' == 'Debug'" ContinueOnError="true" />
        <Copy SourceFiles="@(SyncImageFiles)" DestinationFolder="$(ProjectDir)bin\x64\Debug\images\" Condition="'$(Platform)' != 'x64' And '$(Configuration)' == 'Debug'" ContinueOnError="true" />
        <Copy SourceFiles="@(SyncSoundFiles)" DestinationFolder="$(ProjectDir)bin\Debug\Sounds\" Condition="'$(Platform)' == 'x64' And '$(Configuration)' == 'Debug'" ContinueOnError="true" />
        <Copy SourceFiles="@(SyncSoundFiles)" DestinationFolder="$(ProjectDir)bin\x64\Debug\Sounds\" Condition="'$(Platform)' != 'x64' And '$(Configuration)' == 'Debug'" ContinueOnError="true" />
    </Target>
</Project>

